# Database Configuration
DATABASE_PATH=data/enterprise.db
READONLY_URI=file:data/enterprise.db?mode=ro

# Execution & Guardrail Guardrails
MAX_EXECUTION_TIMEOUT_SECONDS=3.0
MAX_JOIN_DEPTH=6
MAX_SUBQUERY_DEPTH=4
DEFAULT_QUERY_LIMIT=100
STRICT_AST_VALIDATION=true

# Dynamic Vector Retrieval
CHROMA_PERSIST_DIR=data/chroma_exemplars
EMBEDDING_MODEL=all-MiniLM-L6-v2
EXEMPLAR_TOP_K=3

# LLM Providers (Optional for cloud inference; fallback runs deterministic high-accuracy model)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=auto
LLM_MODEL=gpt-4o

# API Server
API_HOST=127.0.0.1
API_PORT=8000
